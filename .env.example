# Place this file at <workspace>/.env, for example ~/.familiar/.env.
# Env var names must match api_key_env in config.toml.

# Optional: Discord bot token (from Discord Developer Portal). Without it, familiar runs web-only.
DISCORD_TOKEN=

# Optional: OneBot access token for QQ (matches the token set in NapCat/Lagrange)
QQ_ONEBOT_TOKEN=

# Required: LLM API key. The env var NAME must match api_key_env in config.toml.
# Default config uses ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Google Vertex ADC support. Use these with gcloud ADC or
# GOOGLE_APPLICATION_CREDENTIALS when config.toml allows google-vertex models.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# TTS
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# STT
GROQ_API_KEY=
OPENROUTER_API_KEY=

#Image generation
LINK_API_KEY=

# Optional web tools
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
TINYFISH_API_KEY=
